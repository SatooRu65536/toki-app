<?xml version="1.0" encoding="utf-8"?>
<!-- 秒まで表示する時計ウィジェット。TextClock は RemoteViews 内でも毎秒自動更新される -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextClock
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="44sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeTextType="uniform"
        android:format12Hour="a h:mm:ss"
        android:format24Hour="H:mm:ss"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFFFF" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="M月d日 EEEE"
        android:format24Hour="M月d日 EEEE"
        android:includeFontPadding="false"
        android:textColor="#FFFF9F0A"
        android:textSize="14sp" />
</LinearLayout>
